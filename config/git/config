[user]
	name = Ryan Cheley
	email = rcheley@gmail.com
[init]
	defaultBranch = main
	templateDir = ~/.config/git/template
[help]
	autocorrect = 10
	format = web
[push]
    autoSetupRemote = true
	followTags = true
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    frag = magenta bold
    meta = yellow bold
    new = green bold
    old = red bold
    whitespace = red reverse
[color "status"]
    added = yellow
    changed = green
    untracked = cyan
[core]
    # Fall back to less/cat on machines without delta, so git log/diff/add -p never break.
    pager = command -v delta >/dev/null && exec delta || exec less
[delta]
    # https://dandavison.github.io/delta/configuration.html
    hyperlinks = true
    line-numbers = true
    navigate = true
    syntax-theme = Monokai Extended
[diff]
	colorMoved = plain
	algorithm = histogram
	mnemonicPrefix = true
	renames = true
[interactive]
    diffFilter = command -v delta >/dev/null && exec delta --color-only || exec cat
[merge]
    conflictStyle = zdiff3
[branch]
	sort = -committerdate
[pull]
	rebase = true
[column]
	ui = auto
[tag]
	sort = version:refname
[fetch]
	prune = true
	pruneTags = true
	all = true
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
    required = true
[includeIf "gitdir:/Users/ryan/Documents/ardotconsulting/"]
      path = /Users/ryan/Documents/ardotconsulting/.gitconfig
